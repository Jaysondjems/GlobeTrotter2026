// GlobeTrotter Travel Assistant - Phase 1 (Monolith)
// Schema Prisma - PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(uuid())
  firstName         String
  lastName          String
  email             String   @unique
  passwordHash      String
  country           String?
  budgetPreference  Float?
  travelPreferences Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  itineraries Itinerary[]

  @@map("users")
}

model Destination {
  id              String   @id @default(uuid())
  name            String
  country         String
  city            String
  description     String?
  category        String
  averageBudget   Float
  popularityScore Int      @default(0)
  activities      Json     @default("[]")
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  itineraryItems ItineraryItem[]

  @@index([country])
  @@index([category])
  @@map("destinations")
}

enum ItineraryStatus {
  DRAFT
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

model Itinerary {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      ItineraryStatus @default(DRAFT)
  shareToken  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ItineraryItem[]

  @@index([userId])
  @@map("itineraries")
}

model ItineraryItem {
  id            String   @id @default(uuid())
  itineraryId   String
  destinationId String
  date          DateTime
  notes         String?
  activities    Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])

  @@index([itineraryId])
  @@index([destinationId])
  @@map("itinerary_items")
}
