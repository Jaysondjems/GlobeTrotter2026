// GlobeTrotter - Phase 2 - itineraries-service
// Owns its own database. userId and destinationId are plain strings (no cross-service
// foreign keys are possible): ownership and referential checks are enforced in application
// code via the JWT (userId) and an HTTP call to destinations-service (destinationId).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItineraryStatus {
  DRAFT
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

model Itinerary {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      ItineraryStatus @default(DRAFT)
  shareToken  String?         @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items ItineraryItem[]

  @@index([userId])
  @@map("itineraries")
}

model ItineraryItem {
  id            String   @id @default(uuid())
  itineraryId   String
  destinationId String
  date          DateTime
  notes         String?
  activities    Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@index([destinationId])
  @@map("itinerary_items")
}
